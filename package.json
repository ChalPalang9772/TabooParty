{
  "name": "taboo-party",
  "version": "1.0.0",
  "description": "Competitive multiplayer word game — esports verbal battlefield",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "next dev --port 3000",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build",
    "start": "node server/index.js",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "express": "^4.19.0",
    "framer-motion": "^11.0.0",
    "canvas-confetti": "^1.9.0",
    "howler": "^2.2.4",
    "fastest-levenshtein": "^1.0.16",
    "nanoid": "^5.0.0",
    "zustand": "^4.5.0",
    "concurrently": "^8.2.0",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/express": "^4.17.0",
    "@types/canvas-confetti": "^1.6.0",
    "@types/howler": "^2.2.0",
    "typescript": "^5.4.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0"
  }
}
